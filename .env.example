# Las claves NUNCA se escriben en este repositorio.
# Se ingresan por la bóveda segura del entorno de producción.
# Este archivo solo documenta qué variables espera el pipeline.

# API key de Fish Audio (voces de respaldo; modelo s2.1-pro-free)
FISH_AUDIO_API_KEY=

# API key de Groq (transcripción whisper-large-v3: verificación y arbitraje)
GROQ_API_KEY=

# Ruta al ayudante de la API de Groq (opcional; los scripts lo buscan en el PATH si no se define)
GROQ_HELPER=
